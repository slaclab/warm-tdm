import time
import argparse
import glob
import os
import sys
import importlib

import pyrogue
import rogue

# Search paths
if '--local' in sys.argv:
    baseDir = os.path.dirname(os.path.realpath(__file__))
    pyrogue.addLibraryPath(f'{baseDir}/../../firmware/python')
    pyrogue.addLibraryPath(f'{baseDir}/../python')
    pyrogue.addLibraryPath(f'{baseDir}/../../firmware/submodules/surf/python')

import warm_tdm
import warm_tdm_api

#rogue.Logging.setFilter('pyrogue.SrpV3', rogue.Logging.Debug)
#rogue.Logging.setFilter('pyrogue._Device', rogue.Logging.Info)

# Set the argument parser
parser = warm_tdm_api.WarmTdmArgparse()
parser.add_argument('--local', action='store_true',
                    help='use Python packages from this checkout')

parser.add_argument(
    "--path", '-p',
    type     = str,
    required = False,
    default = None,
    help     = "path to image",
)

reload_mode = parser.add_mutually_exclusive_group()
reload_mode.add_argument(
    "--reload", '-r',
    action   = 'store_true',
    help     = "after programming the PROM, reload (reboot) that board's FPGA from PROM",
)

reload_mode.add_argument(
    "--reload-only", '-R',
    action   = 'store_true',
    help     = "skip programming; only reload (reboot) a board's FPGA from PROM",
)

args = parser.parse_args()
print(args)

arg_dict = warm_tdm_api.arg_dict(args)
arg_dict['pollEn'] = False
arg_dict['initRead'] = False

def select_index(text, values):
    index = int(text)
    if not 0 <= index < len(values):
        raise ValueError(f"Selection must be in 0..{len(values) - 1}")
    return values[index]


with warm_tdm_api.GroupRoot(**arg_dict) as root:

#     devs = root.find(name='WarmTdmCore')
#     for d in devs:
#         d.enable.set(False)

    print('Finding and reading group')

    avs = root.find(name='AxiVersion')

    print('Found the following boards')
    for i, av in enumerate(avs):
        print(f'Board {i} - {av.path}')
        av.readBlocks()
        av.waitBlocks()
        av.printStatus()
        print()

    def reload_fpga(av):
        # FpgaReload is a posted write (no response is expected): the FPGA
        # reboots from the PROM and the SRP link drops, so this is necessarily
        # the last transaction we issue on that board.
        print(f'Reloading FPGA from PROM via {av.path} '
              '(the FPGA will reboot and the link will drop)...')
        av.FpgaReload()

    # Stand-alone reload: skip programming entirely, just reboot a board (or all
    # boards) from whatever image is already in its PROM.
    if args.reload_only:
        sel = input("Select which board's FPGA to reload [index or 'all']: ").strip()
        if sel == 'all':
            coordinator = root.Group.HardwareGroup.ColumnBoard[0].WarmTdmCore.WarmTdmCommon2.AxiVersion
            if sum(av.path == coordinator.path for av in avs) != 1:
                raise RuntimeError("Cannot identify the coordinator in the reload targets")
            # Reload downstream boards first; the coordinator owns the host link.
            targets = [av for av in reversed(avs) if av.path != coordinator.path] + [coordinator]
        else:
            targets = [select_index(sel, avs)]
        x = input(f'Reload {len(targets)} FPGA(s) from PROM [y]/n: ')
        if x == 'n':
            exit()
        for av in targets:
            reload_fpga(av)
        exit()

    proms = root.find(name='AxiMicronN25Q')

    print('Found the following PROMs')

    for i, prom in enumerate(proms):
        print(f'{i} - {prom.path}')

    prom = select_index(input('Select which PROM you wish to flash: '), proms)
    prom.enable.set(True)

    if args.path is None:
        BasePackage = importlib.import_module('warm_tdm')
        args.path = BasePackage.ImageDir

    if os.path.isdir(args.path):
        # Get a list of images
        images = glob.glob('{}/*.mcs*'.format(args.path))
        images = list(reversed(sorted(images)))

        for i, l in enumerate(images):
            print('{} : {}'.format(i, l))

        image = select_index(input('Enter image for flash: '), images)
    else:
        image = args.path


    print(f'Loading {image} to {prom.path}')
    x = input('Are you sure you wish to procede [y]/n: ')
    if x == 'n':
        exit()

    print(f'Loading MCS file: {image}')
    prom.LoadMcsFile(image)

    # Optionally reboot the just-programmed board from its new PROM image. The
    # PROM and the AxiVersion are siblings on the same board (WarmTdmCommon), so
    # the board to reload is simply the flashed PROM's sibling AxiVersion.
    if args.reload:
        av = getattr(prom.parent, 'AxiVersion', None)
        if av is None:
            found = prom.parent.find(name='AxiVersion')
            av = found[0] if found else None
        if av is None:
            print(f'WARNING: no AxiVersion found alongside {prom.path}; cannot '
                  'reload. Power-cycle the board or rerun with --reload-only.')
        else:
            reload_fpga(av)

exit()


